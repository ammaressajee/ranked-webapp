rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Config - admins list (bootstrap via Firestore Console)
    match /config/admins {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null &&
        request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
    }

    // User profiles - read public, write own
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Leagues - read public, create/update/delete admins only
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null &&
        exists(/databases/$(db)/documents/config/admins) &&
        request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
      allow update, delete: if request.auth != null &&
        exists(/databases/$(db)/documents/config/admins) &&
        request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
    }

    // League requests - users create, admins update
    match /leagueRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.requestedBy == request.auth.uid;
      allow update: if request.auth != null &&
        exists(/databases/$(db)/documents/config/admins) &&
        request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
    }

    // League participants - read public; create any (join); update/delete only own or admin
    match /leagueParticipants/{participantId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.get('userId', '') == request.auth.uid ||
         (exists(/databases/$(db)/documents/config/admins) &&
          request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', [])));
      allow delete: if request.auth != null &&
        (resource.data.get('userId', '') == request.auth.uid ||
         (exists(/databases/$(db)/documents/config/admins) &&
          request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', [])));
    }

    // League matches - read/update if authenticated; create only by backend (Cloud Functions)
    match /leagueMatches/{matchId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        exists(/databases/$(db)/documents/config/admins) &&
        request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
    }

    // Match messages - players in the match can read/create; senderUid must be their own uid
    match /matchMessages/{matchId}/messages/{msgId} {
      allow read: if request.auth != null &&
        (request.auth.uid == get(/databases/$(db)/documents/leagueMatches/$(matchId)).data.playerA ||
         request.auth.uid == get(/databases/$(db)/documents/leagueMatches/$(matchId)).data.playerB);
      allow create: if request.auth != null &&
        request.resource.data.senderUid == request.auth.uid &&
        (request.auth.uid == get(/databases/$(db)/documents/leagueMatches/$(matchId)).data.playerA ||
         request.auth.uid == get(/databases/$(db)/documents/leagueMatches/$(matchId)).data.playerB);
    }

    // Search requests - read for UI (queue status); write only by Cloud Functions (matchmaking)
    match /searchRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Legacy matches (Record Match flow)
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Legacy ladders
    match /ladders/{ladderId} {
      allow read: if true;
      allow update: if request.auth != null;
    }
  }
}
